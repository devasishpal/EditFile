{
  "name": "editfile-backend",
  "version": "1.0.0",
  "description": "Production-ready file processing backend for EditFile SaaS",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon --watch src --ext js,mjs,cjs,json src/app.js",
    "dev:local": "set LOCAL_MODE=true&& nodemon --watch src --ext js,mjs,cjs,json src/app.js",
    "worker": "node src/queue/worker.js",
    "cleanup": "node src/services/cleanup.service.js",
    "test": "jest",
    "lint": "eslint src/"
  },
  "keywords": [
    "pdf",
    "image",
    "processing",
    "saas",
    "file-tools"
  ],
  "author": "EditFile",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "axios": "^1.13.6",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dompurify": "^3.3.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsdom": "^28.1.0",
    "libreoffice-convert": "^1.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "piscina": "^4.2.1",
    "puppeteer": "^24.39.0",
    "sharp": "^0.33.1",
    "tesseract.js": "^5.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
