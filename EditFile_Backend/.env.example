# ============================================
# EditFile Backend - Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173,https://*.vercel.app
BACKEND_PUBLIC_URL=http://localhost:5000
LOCAL_MODE=true
LOCAL_STORAGE_PATH=storage
FILE_STORAGE_PATH=storage

# Database Configuration (CockroachDB) - required only when LOCAL_MODE=false
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Redis Configuration (Upstash or Railway Redis) - required only when LOCAL_MODE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cloudflare R2 (S3-compatible) - required only when LOCAL_MODE=false
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=editfile-uploads
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_PUBLIC_URL=
# Optional S3 compatibility (kept for AWS S3 users)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Worker Configuration
WORKER_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_RATE_LIMIT_MAX=20

# File Limits
MAX_FILE_SIZE_MB=100
MAX_IMAGE_SIZE_MB=50

# Remove Background Runtime
PYTHON_EXECUTABLE=
REMOVE_BG_TIMEOUT_MS=300000
REMOVE_BG_MAX_BUFFER_BYTES=10485760
REMBG_MODEL=auto
REMBG_ALPHA_MATTING=1
REMBG_ALPHA_FOREGROUND_THRESHOLD=240
REMBG_ALPHA_BACKGROUND_THRESHOLD=10
REMBG_ALPHA_ERODE_SIZE=10
REMBG_POST_PROCESS_MASK=1
REMBG_EDGE_BLUR_RADIUS=0.35
REMBG_ALPHA_CLIP_LOW=5
REMBG_ALPHA_CLIP_HIGH=250
REMBG_ENABLE_DEFRINGE=1
